{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/motor-speech-voice/source-survey-schema-v1.0.0.json",
  "title": "Item 23 candidate reference source survey record",
  "description": "One publicly identifiable data source examined during checkpoint 23B. A record states what a source could supply, what it may lawfully be used for, and whether it can be obtained at all. It never selects a source, authorises acquisition, or decides that a source satisfies an item 23 truth requirement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "source_id",
    "title",
    "citation",
    "canonical_source",
    "language_and_variety",
    "population",
    "tasks_present",
    "reference_truth",
    "access",
    "licence",
    "capability_audit",
    "eligibility",
    "governance"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "title": {"type": "string", "minLength": 1},
    "citation": {"type": "string", "minLength": 1},
    "canonical_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["landing_page", "terms_or_licence_url"],
      "properties": {
        "landing_page": {"type": "string", "minLength": 1},
        "terms_or_licence_url": {"type": ["string", "null"]}
      }
    },
    "language_and_variety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "variety", "covers_australian_english"],
      "properties": {
        "language": {"type": "string", "minLength": 1},
        "variety": {"type": ["string", "null"]},
        "covers_australian_english": {"type": "boolean"}
      }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "age_band", "clinical_status", "limitations"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "age_band": {"enum": ["adults", "children", "mixed", "unknown"]},
        "clinical_status": {
          "enum": ["healthy", "clinical", "mixed", "listeners", "unknown"]
        },
        "limitations": {"$ref": "#/$defs/nonemptyStrings"}
      }
    },
    "tasks_present": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reference_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offered_truth_class",
        "independent_rater_or_annotator_count",
        "individual_records_retained",
        "adjudication_defined",
        "requirement_status",
        "failure_reasons"
      ],
      "properties": {
        "offered_truth_class": {
          "enum": [
            "motor_task_timing_two_annotator",
            "motor_task_accuracy_two_annotator",
            "perceptual_voice_multi_rater",
            "perceptual_voice_single_rater",
            "perceptual_voice_consensus_only",
            "intelligibility_multi_listener_transcription",
            "population_description_only",
            "derived_measures_without_audio",
            "audio_without_qualifying_labels",
            "none",
            "unresolved"
          ]
        },
        "independent_rater_or_annotator_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "individual_records_retained": {"type": ["boolean", "null"]},
        "adjudication_defined": {"type": ["boolean", "null"]},
        "requirement_status": {
          "description": "Whether this source satisfies the item 23 truth requirement for its lane. Only 'fails' and 'unresolved' are representable. Deciding that a source MEETS a truth requirement is a governance judgement reserved for the accountable independent roles, and this survey must never encode it.",
          "enum": ["fails", "unresolved"]
        },
        "failure_reasons": {"$ref": "#/$defs/nonemptyStrings"}
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "contact_with_a_person_required",
        "organisation_signatory_required",
        "account_required",
        "agreement_signature_required",
        "fee",
        "state",
        "checked_at"
      ],
      "properties": {
        "route": {
          "enum": [
            "open_direct_download",
            "free_account",
            "free_account_and_signed_agreement",
            "signed_agreement_with_organisation_signatory",
            "application_and_review",
            "email_request_to_authors",
            "paid_licence",
            "no_public_release_located",
            "host_unreachable"
          ]
        },
        "contact_with_a_person_required": {"type": "boolean"},
        "organisation_signatory_required": {"type": "boolean"},
        "account_required": {"type": "boolean"},
        "agreement_signature_required": {"type": "boolean"},
        "fee": {"type": ["string", "null"]},
        "state": {
          "enum": [
            "obtainable_without_contact",
            "obtainable_only_after_contact_or_agreement",
            "restricted",
            "unobtainable"
          ]
        },
        "checked_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stated",
        "spdx_id",
        "commercial_use_permitted",
        "source_of_licence_string",
        "verified_at"
      ],
      "properties": {
        "stated": {"type": ["string", "null"]},
        "spdx_id": {"type": ["string", "null"]},
        "commercial_use_permitted": {"type": ["boolean", "null"]},
        "source_of_licence_string": {
          "enum": [
            "repository_page",
            "catalogue_page",
            "project_page",
            "publication_text",
            "not_stated"
          ]
        },
        "verified_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    },
    "capability_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_level",
        "inspected_materials",
        "findings",
        "conflicting_claims"
      ],
      "properties": {
        "verification_level": {
          "enum": ["verified_directly", "reported_not_verified"]
        },
        "inspected_materials": {"$ref": "#/$defs/nonemptyStrings"},
        "findings": {"$ref": "#/$defs/nonemptyStrings"},
        "conflicting_claims": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reasons", "selected"],
      "properties": {
        "decision": {
          "enum": [
            "blocked_licence_non_commercial",
            "blocked_licence_unresolved",
            "blocked_access_requires_organisation",
            "blocked_access_restricted",
            "blocked_truth_class",
            "blocked_host_unreachable",
            "blocked_no_public_release",
            "open_but_truth_class_unresolved",
            "out_of_scope_population"
          ]
        },
        "reasons": {"$ref": "#/$defs/nonemptyStrings"},
        "selected": {"const": false}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permitted_roles",
        "prohibited_roles",
        "raw_data_committed",
        "acquisition_authorised",
        "transfer_to_any_provider"
      ],
      "properties": {
        "permitted_roles": {"$ref": "#/$defs/nonemptyStrings"},
        "prohibited_roles": {"$ref": "#/$defs/nonemptyStrings"},
        "raw_data_committed": {"const": false},
        "acquisition_authorised": {"const": false},
        "transfer_to_any_provider": {"const": "blocked"}
      }
    }
  },
  "$defs": {
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
