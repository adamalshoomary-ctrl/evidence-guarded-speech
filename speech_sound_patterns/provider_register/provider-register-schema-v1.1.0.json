{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "speech-sound-provider-register-schema-v1.1.0",
  "title": "Checkpoint 22E provider, model and acquisition lane register, version 1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "register_id",
    "register_version",
    "checkpoint",
    "updated",
    "secrets_policy",
    "lanes",
    "recorded_rejections"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "register_id": {
      "const": "speech_sound_provider_register"
    },
    "register_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "type": "string"
    },
    "checkpoint": {
      "enum": [
        "22E1",
        "22E3"
      ]
    },
    "updated": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
    },
    "secrets_policy": {
      "const": "credentials are referenced by gitignored .env variable name only; no secret value, account password, multifactor code or recovery code may ever appear in this register"
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lane"
      }
    },
    "recorded_rejections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate",
          "reason",
          "evidence"
        ],
        "properties": {
          "candidate": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/evidence_item"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "source",
        "verified"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "verified": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_id",
        "display_name",
        "kind",
        "role",
        "status",
        "reason",
        "audio_policy",
        "eligible_sources",
        "output_semantics",
        "permissions",
        "prohibited_uses",
        "blocked_pending",
        "evidence"
      ],
      "properties": {
        "lane_id": {
          "pattern": "^[a-z0-9_]+$",
          "type": "string"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "external_api",
            "local_method",
            "local_model",
            "acquisition_path"
          ]
        },
        "role": {
          "enum": [
            "core_local_repair",
            "core_local_free_phone_comparator",
            "core_external_score_comparator",
            "conditional_external_exact_substitution",
            "experimental_public_corpus_comparator",
            "conditional_local_free_phone",
            "supporting_only_local_comparator",
            "research_only_articulatory",
            "conditional_child_feasibility",
            "australian_child_acquisition_collaboration",
            "conditional_prompt_target_support",
            "rejected_unobtainable",
            "conditional_reserve",
            "rejected_by_terms"
          ]
        },
        "status": {
          "enum": [
            "ready",
            "conditional",
            "blocked",
            "supporting_only",
            "research_only",
            "rejected",
            "owner_declined"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 20
        },
        "audio_policy": {
          "enum": [
            "no_audio",
            "public_corpus_only",
            "corpus_transfer_review_required",
            "blocked"
          ]
        },
        "eligible_sources": {
          "type": "array",
          "items": {
            "pattern": "^[a-z0-9_]+$",
            "type": "string"
          }
        },
        "output_semantics": {
          "type": "string",
          "minLength": 20
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "benchmark_publication",
            "evidence"
          ],
          "properties": {
            "benchmark_publication": {
              "enum": [
                "permitted_by_public_terms",
                "written_permission_required",
                "prohibited_without_waiver",
                "not_applicable_local"
              ]
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/evidence_item"
              }
            }
          }
        },
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "processing_region",
            "retention",
            "training_use"
          ],
          "properties": {
            "processing_region": {
              "type": "string",
              "minLength": 1
            },
            "retention": {
              "type": "string",
              "minLength": 1
            },
            "training_use": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "env_var_names",
            "verified"
          ],
          "properties": {
            "env_var_names": {
              "type": "array",
              "minItems": 1,
              "items": {
                "pattern": "^[A-Z][A-Z0-9_]+$",
                "type": "string"
              }
            },
            "verified": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "date",
                "method",
                "outcome"
              ],
              "properties": {
                "date": {
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                  "type": "string"
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "outcome": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "lineage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model_id",
            "revision",
            "licence_evidence",
            "training_data",
            "non_independent_sources"
          ],
          "properties": {
            "model_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "revision": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{40}$"
            },
            "licence_evidence": {
              "type": "string",
              "minLength": 1
            },
            "training_data": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "non_independent_sources": {
              "type": "array",
              "items": {
                "pattern": "^[a-z0-9_]+$",
                "type": "string"
              }
            }
          }
        },
        "prohibited_uses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blocked_pending": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_item"
          }
        },
        "transfer_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "review_id",
            "review_version",
            "permitted_sources"
          ],
          "properties": {
            "review_id": {
              "const": "speech_sound_corpus_provider_transfer_review"
            },
            "review_version": {
              "pattern": "^\\d+\\.\\d+\\.\\d+$",
              "type": "string"
            },
            "permitted_sources": {
              "type": "array",
              "items": {
                "pattern": "^[a-z0-9_]+$",
                "type": "string"
              }
            }
          }
        },
        "observed_output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "checkpoint",
            "summary",
            "evidence"
          ],
          "properties": {
            "checkpoint": {
              "const": "22E3"
            },
            "summary": {
              "type": "string",
              "minLength": 20
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/evidence_item"
              }
            }
          }
        }
      }
    }
  }
}
