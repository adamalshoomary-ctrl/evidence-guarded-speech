    "rules": {
      "unavailable": "Rejected or unavailable audio, an unknown intended word, a missing required local model or version, or unreadable evidence becomes unavailable with its reason. Audio quality is resolved before automatic speech evidence is interpreted.",
      "known_reference_variant": "After usable audio is established, a prompt pack opportunity whose documented British and Australian reference forms disagree remains a known reference variant and never becomes a concern.",
      "unsupported": "After usable audio is established, any other prompt pack refusal, unsupported sound or context, or an unimplemented insertion lane becomes unsupported and never becomes normal, correct or zero.",
      "candidate_system_conflict": "Materially different automatic proposals are preserved as conflict and agreement still cannot become truth.",
      "asr_only_disagreement": "ASR disagreement without independent phone relation evidence remains one word level review unit. It is never copied onto expected sound opportunities and cannot create a speech sound concern.",
      "insufficient_evidence": "Scorable opportunities with raw evidence but no frozen passing candidate rule remain insufficient evidence.",
      "possible_relation_candidate": "This state requires a separately frozen candidate rule that passed every unchanged gate on task matched development and tuning evidence."
    },
    "possible_relation_candidate_emission_enabled": false,
    "reason": "No candidate system, mapping, feature rule or threshold was selected, and the task matched evidence adequacy gate fails before any new search."
