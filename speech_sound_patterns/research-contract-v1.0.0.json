{
  "schema_version": "1.0.0",
  "protocol_id": "speech_sound_pattern_research_en",
  "protocol_version": "1.0.0",
  "status": "research_design_only_no_automatic_measurement",
  "language": "en",
  "purpose": "Define how future research may separate an observed speech sound production, a repeated sound pattern, an ASR error, and legitimate accent or dialect variation without diagnosing a disorder.",
  "claim_boundaries": {
    "allowed_claim_levels": [
      "measured_observation"
    ],
    "forbidden_outputs": [
      "articulation_score",
      "phonology_score",
      "pronunciation_score",
      "accent_quality",
      "native_likeness",
      "disorder_label",
      "screening_result",
      "diagnosis",
      "severity",
      "cause_or_etiology",
      "ranking_between_people",
      "personal_progress",
      "treatment_recommendation"
    ],
    "asr_text_is_lexical_intent": false,
    "asr_is_phone_truth": false,
    "automatic_system_agreement_is_truth": false,
    "automatic_absence_establishes_typical_speech": false
  },
  "constructs": {
    "speech_sound_production_observation": {
      "definition": "A time linked, independently reviewed record of what speech sound appears to have been produced in one known task opportunity.",
      "does_not_establish": [
        "error",
        "cause",
        "disorder",
        "treatment_need"
      ],
      "automatic_state": "unavailable"
    },
    "target_relation_observation": {
      "definition": "A reviewed relation between the production record and every professionally accepted pronunciation variant for the intended word in that task context.",
      "does_not_establish": [
        "disorder",
        "accent_quality",
        "cause"
      ],
      "automatic_state": "unavailable"
    },
    "phonological_pattern_hypothesis": {
      "definition": "A descriptive hypothesis supported by repeated independently reviewed target relations across multiple eligible opportunities, sound contexts and words.",
      "does_not_establish": [
        "phonological_disorder",
        "developmental_status",
        "cause",
        "severity"
      ],
      "automatic_state": "unavailable"
    },
    "asr_disagreement": {
      "definition": "A difference between an automatic word hypothesis and an independently established intended or heard word.",
      "does_not_establish": [
        "speech_sound_difference",
        "speaker_error",
        "low_intelligibility"
      ],
      "automatic_state": "research_context_only"
    },
    "legitimate_language_or_variety_form": {
      "definition": "A production consistent with a professionally reviewed language, accent, dialect, allophonic or cross linguistic pattern relevant to the speaker and task.",
      "can_be_error": false,
      "automatic_state": "unavailable"
    }
  },
  "task_policy": {
    "active_task": null,
    "active_stimulus_pack": null,
    "primary_future_task": "controlled_word_research_en_v1",
    "primary_task_contract": "assessment/pronunciation-research-v1.0.0.json",
    "activation_requires_professionally_reviewed_word_pack": true,
    "elicitation_modes": {
      "controlled_word": {
        "role": "primary_development_and_evaluation",
        "status": "locked",
        "intended_word_source": "versioned_presented_stimulus",
        "limitations": [
          "reading_ability",
          "word_familiarity",
          "prompt_imitation_for_spoken_alternative"
        ]
      },
      "sentence_or_connected_speech": {
        "role": "secondary_transfer_evidence",
        "status": "research_protocol_not_defined",
        "intended_word_source": "independent_human_confirmation_required",
        "limitations": [
          "coarticulation",
          "speech_rate",
          "word_boundary_uncertainty",
          "style_and_context"
        ]
      },
      "spontaneous_speech": {
        "role": "context_only_until_separately_validated",
        "status": "locked_for_target_relation_and_pattern_inference",
        "intended_word_source": "asr_forbidden",
        "limitations": [
          "unknown_lexical_intent",
          "self_repair",
          "reduced_forms",
          "connected_speech_variation"
        ]
      }
    },
    "elicitation_modes_are_comparable": false,
    "cross_task_pooling": "blocked",
    "repeated_productions_required": true,
    "pattern_minimum_opportunities": null,
    "pattern_minimum_rule_status": "requires_professional_design_and_development_data"
  },
  "evidence_model": {
    "layers_kept_separate": [
      "source_audio_and_quality",
      "task_prompt_and_intended_word",
      "blind_listener_word_transcriptions",
      "blind_human_production_transcriptions",
      "reviewed_variant_set",
      "target_relation_reviews",
      "raw_asr_outputs",
      "raw_candidate_system_outputs",
      "reviewer_disagreements_and_adjudication",
      "versioned_provenance"
    ],
    "production_units": [
      "consonant",
      "vowel",
      "diphthong",
      "consonant_cluster",
      "syllable_shape"
    ],
    "target_relation_outcomes": [
      "accepted_variant",
      "observed_substitution",
      "observed_deletion",
      "observed_insertion",
      "observed_distortion",
      "uncertain",
      "unscorable"
    ],
    "pattern_outcomes": [
      "evidence_supported_pattern_hypothesis",
      "insufficient_opportunities",
      "language_or_variety_consistent",
      "uncertain",
      "unscorable"
    ],
    "required_primitive_fields": [
      "participant_id",
      "session_id",
      "attempt_id",
      "trial_id",
      "stimulus_id",
      "elicitation_mode",
      "start_s",
      "end_s",
      "audio_quality_status",
      "intended_word_source",
      "blind_listener_records",
      "blind_production_records",
      "variant_set_version",
      "target_relation_reviews",
      "raw_asr_outputs",
      "raw_candidate_outputs",
      "review_state",
      "provenance"
    ],
    "denominators": {
      "expected_word_opportunities": "Every presented word before technical or evidence exclusions.",
      "scorable_word_opportunities": "Expected words remaining after documented exclusions.",
      "expected_sound_opportunities": "Every professionally reviewed sound opportunity across all accepted variants before exclusions.",
      "scorable_sound_opportunities": "Expected sound opportunities remaining after quality, variant and evidence exclusions.",
      "insertions": "Separate observations that never change an expected opportunity denominator.",
      "pattern_support": "Report supporting opportunities, eligible opportunities, distinct words, contexts and sessions without hiding any denominator."
    },
    "missing_evidence_is_zero": false,
    "production_transcription_is_infallible": false,
    "combined_score_allowed": false
  },
  "reference_truth": {
    "blind_listener_reference": {
      "construct": "The word an independent listener actually understood.",
      "listener_sees_prompt_or_expected_word": false,
      "listener_sees_automatic_outputs": false,
      "kept_separate_from_sound_production": true
    },
    "two_pass_production_review": {
      "pass_one": "At least two qualified reviewers independently record the audible production before seeing the expected word, accepted variant set or automatic outputs.",
      "pass_two": "Reviewers compare the retained production records with the intended word and all accepted variants, then record the target relation without erasing pass one.",
      "independent_reviewers": 2,
      "reviewers_blind_to_automatic_outputs": true,
      "pass_one_blind_to_expected_word": true,
      "original_records_retained": true,
      "disagreements_retained": true,
      "documented_adjudication": true,
      "broad_ipa_default": true,
      "narrow_transcription_requires_separate_protocol_and_reliability": true,
      "reviewer_language_and_variety_competence_recorded": true
    },
    "variant_reference": {
      "unit": "word_specific_versioned_union_of_accepted_forms",
      "qualified_professional_review_required": true,
      "relevant_language_and_variety_expertise_required": true,
      "unresolved_form_behavior": "unscorable",
      "self_report_alone_creates_truth": false
    },
    "single_reviewer_is_reference_truth": false,
    "automatic_system_is_reference_truth": false
  },
  "asr_and_alignment_separation": {
    "raw_asr_retained_as_system_evidence": true,
    "asr_may_trigger_manual_review": true,
    "asr_disagreement_may_create_sound_concern": false,
    "asr_confidence_is_phone_probability": false,
    "multiple_asr_agreement_is_truth": false,
    "expected_text_forced_alignment_verifies_production": false,
    "forced_alignment_role": "candidate_interval_localisation_only",
    "phone_recognizer_role": "candidate_system_only",
    "provider_pronunciation_score_role": "raw_research_output_only",
    "llm_may_infer_produced_phone": false,
    "required_error_attribution_states": [
      "human_production_and_asr_agree",
      "asr_only_disagreement",
      "human_confirmed_target_relation_difference",
      "human_reference_disagreement",
      "unscorable"
    ]
  },
  "language_and_variety_policy": {
    "single_standard_accent_allowed": false,
    "acceptable_variant_can_be_error": false,
    "unsupported_or_unrepresented_form_behavior": "unscorable",
    "self_reported_language_or_variety_is_context_not_truth": true,
    "language_history_may_be_inferred_from_voice": false,
    "cross_linguistic_transfer_is_disorder": false,
    "accent_modification_is_elective_and_separate": true,
    "listener_bias_is_speaker_impairment": false,
    "professional_or_linguistic_broker_review_required_when_expertise_missing": true
  },
  "pattern_policy": {
    "active_pattern_registry": [],
    "pattern_requires_human_confirmed_target_relations": true,
    "single_opportunity_can_create_pattern": false,
    "asr_errors_can_create_pattern": false,
    "pattern_requires_multiple_words_and_contexts": true,
    "support_and_opportunity_counts_required": true,
    "consistency_must_be_reported": true,
    "language_and_variety_explanation_checked_first": true,
    "pattern_label_is_disorder": false,
    "numeric_pattern_thresholds": null,
    "threshold_status": "not_set_before_professional_review_and_development_data"
  },
  "consent_policy": {
    "required_separate_consents": [
      "research_collection",
      "human_review",
      "raw_audio_retention"
