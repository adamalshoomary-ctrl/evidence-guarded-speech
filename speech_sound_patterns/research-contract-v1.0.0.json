      "word and phonetic context",
      "voice range",
      "device and audio quality",
      "speech difference",
      "consented target population strata"
    ],
    "sample_size_rule": "Predeclare and justify participant, listener and reviewer sample sizes before collection; the owner recordings cannot establish population performance.",
    "release_thresholds": null
