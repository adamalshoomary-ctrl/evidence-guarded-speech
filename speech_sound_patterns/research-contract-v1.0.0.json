    "fairness_metadata_requires_separate_consent": true,
    "declining_research_affects_normal_coaching": false,
    "consent_may_be_inferred": false
  },
  "candidate_systems": {
    "selected_system": null,
    "comparison_status": "not_started_no_active_task_or_independent_corpus",
