  "protocol_version": "1.4.0",
  "status": "benchmark_harness_complete_candidate_engineering_not_active",
  "language": "en",
  "purpose": "Govern developer-only offline engineering that may separate an automatic speech sound relation candidate, repeated relation evidence, ASR error, and legitimate accent or dialect variation without creating product or clinical claims.",
  "claim_boundaries": {
    "allowed_claim_levels": [
      "measured_observation"
    ],
    "forbidden_outputs": [
      "articulation_score",
      "phonology_score",
      "pronunciation_score",
      "accent_quality",
      "native_likeness",
      "disorder_label",
      "screening_result",
      "diagnosis",
      "severity",
      "cause_or_etiology",
      "ranking_between_people",
      "personal_progress",
      "treatment_recommendation"
    ],
    "asr_text_is_lexical_intent": false,
    "asr_is_phone_truth": false,
    "automatic_system_agreement_is_truth": false,
    "automatic_absence_establishes_typical_speech": false
  },
  "constructs": {
    "speech_sound_production_observation": {
      "definition": "A time linked, independently reviewed record of what speech sound appears to have been produced in one known task opportunity.",
      "does_not_establish": [
        "error",
        "cause",
        "disorder",
        "treatment_need"
      ],
      "automatic_state": "unavailable"
    },
    "target_relation_observation": {
      "definition": "A reviewed relation between the production record and every professionally accepted pronunciation variant for the intended word in that task context.",
      "does_not_establish": [
        "disorder",
        "accent_quality",
        "cause"
      ],
      "automatic_state": "unavailable"
    },
    "phonological_pattern_hypothesis": {
      "definition": "A descriptive hypothesis supported by repeated independently reviewed target relations across multiple eligible opportunities, sound contexts and words.",
      "does_not_establish": [
        "phonological_disorder",
        "developmental_status",
        "cause",
        "severity"
      ],
      "automatic_state": "unavailable"
    },
    "asr_disagreement": {
      "definition": "A difference between an automatic word hypothesis and an independently established intended or heard word.",
      "does_not_establish": [
        "speech_sound_difference",
        "speaker_error",
        "low_intelligibility"
      ],
      "automatic_state": "research_context_only"
    },
    "legitimate_language_or_variety_form": {
      "definition": "A production consistent with a professionally reviewed language, accent, dialect, allophonic or cross linguistic pattern relevant to the speaker and task.",
      "can_be_error": false,
      "automatic_state": "unavailable"
    }
  },
