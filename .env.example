# Copy this file to .env in the same directory, then type each value you have
# after its equals sign. Delete the lines you do not need: which ones a run
# requires depends on the command, and the table in README.md says which.
#
# .env is plain text and is not encrypted. It is gitignored and has never been
# committed. Keep it readable only by you: chmod 600 .env
#
# Every value below is deliberately empty. This file carries no key and no
# placeholder that could be mistaken for one, which is also what lets the
# release verifier tell a template apart from a leaked credential. An empty
# value counts as not set, so a copied but unfilled file behaves exactly like
# no file: the run stops and names what is missing.

# Transcribes the recording. Needed by every run except --transcriber local.
# Issued at https://www.assemblyai.com/dashboard/signup
ASSEMBLYAI_API_KEY=

# Downloads the speaker diarization model. Needed by --mode conversation only.
# Issued at https://huggingface.co/settings/tokens
# A valid token is not enough on its own: accept the model user agreement at
# https://hf.co/pyannote/speaker-diarization-3.1 first, or the download returns
# a bare 401 that does not explain itself.
HF_TOKEN=

# Runs the language model stages. Required by --interpret. In conversation mode
# without --interpret it is optional: the speaker label referee uses it, and the
# run says so and continues if it is absent.
# Issued at https://aistudio.google.com/apikey
GEMINI_API_KEY=
